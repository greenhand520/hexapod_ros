        <mxCell id="p_dist" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;shadow=1;" value="&lt;b style=&quot;color:#5C3D00&quot;&gt;取电板 (电源分配)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#6B4400&quot;&gt;DCDC 5V 输出 → 鲁班猫扩展板&lt;br&gt;电池电压输出 → 其他设备&lt;/font&gt;" vertex="1">
