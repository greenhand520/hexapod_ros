        <mxCell id="p_bat" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;shadow=1;" value="&lt;b style=&quot;color:#8B0000&quot;&gt;4S 锂电池&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#6B1C1C&quot;&gt;14.8V nominal&lt;br&gt;21700 电芯&lt;br&gt;~5000 mAh&lt;/font&gt;" vertex="1">
