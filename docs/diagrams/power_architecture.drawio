        <mxCell id="pa5" edge="1" parent="1" source="p_dist" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;strokeColor=#82B366;fontColor=#1a5c1a;fontSize=11;fontStyle=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="p_luban" value="5V">
