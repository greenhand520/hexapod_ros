        </mxCell>
        <mxCell id="pa6" edge="1" parent="1" source="p_dist" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=3;strokeColor=#FF6600;fontColor=#BF360C;fontSize=10;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="p_servo" value="电池电压">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pa7" edge="1" parent="1" source="p_bq40" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=1;strokeColor=#9673A6;fontColor=#4A2D6B;fontSize=9;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="p_dist" value="SMBus 电量数据">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pwr_sum" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#D6B656;fontSize=11;verticalAlign=top;spacingTop=5;align=left;" value="&lt;b style=&quot;color:#5C3D00&quot;&gt;电源路径总结&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.7;color:#2d2d2d&quot;&gt;🔋 4S 锂电池 (14.8V) → BQ40Z50 (保护) → 取电板&lt;br&gt;⚡ 取电板 5V 输出 → 鲁班猫扩展板 → 鲁班猫 +&amp;nbsp;YDLIDAR X2&lt;br&gt;⚡ 取电板 电池电压 → DC-DC 降压 → 舵机 (≈8.4V)&lt;br&gt;🔌 外部适配器 (≤100W) → BQ24725 → 电池充电&lt;br&gt;📊 STM32 通过 SMBus / I2C 读取 BQ40Z50 + BQ24725 数据&lt;/div&gt;" vertex="1">
          <mxGeometry height="155" width="420" y="560" as="geometry" />
        </mxCell>
        <mxCell id="pwr_spec" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#D6B656;fontSize=11;verticalAlign=top;spacingTop=5;align=left;" value="&lt;b style=&quot;color:#5C3D00&quot;&gt;电气规格&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.7;color:#2d2d2d&quot;&gt;电池: 4S 允福亨50Q 21700 16.8V MAX, ~5000mAh&lt;br&gt;充电: BQ24725, 最大 100W, I2C 控制&lt;br&gt;保护: BQ40Z50, 过充/过放/过流/短路&lt;br&gt;舵机: TPS40305 DC-DC Buck 8.4V@20A MAX&lt;br&gt;鲁班猫/YDLIDAR X2: TPS54821 DC-DC Buck 5V@6A MAX&lt;br&gt;STM32:&amp;nbsp;&lt;span style=&quot;background-color: transparent;&quot;&gt;RY8310 5V@1.2A MAX | ME6217 3.3V LDO@800mA MAX | RT9013 3.3V LDO@500mA MAX&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="155" width="490" x="580" y="560" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
