        <mxCell id="pwr_sum" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#D6B656;fontSize=11;verticalAlign=top;spacingTop=5;align=left;" value="&lt;b style=&quot;color:#5C3D00&quot;&gt;Power Path Summary&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.7;color:#2d2d2d&quot;&gt;🔋 4S Li-ion (14.8V) → BQ40Z50 (Protection) → Power Distribution Board&lt;br&gt;⚡ Power Board 5V Output → LubanCat Zero expansion →LubanCat Zero + YDLIDAR X2&lt;br&gt;⚡ Power Board Battery Voltage → DC-DC Buck → Servos (≈8.4V)&lt;br&gt;🔌 External Adapter (⩾100W) → BQ24725 → Battery Charging&lt;br&gt;📊 STM32 via SMBus / I2C Read BQ40Z50 + BQ24725 Data&lt;/div&gt;" vertex="1">
          <mxGeometry height="155" width="460" x="-30" y="560" as="geometry" />
        </mxCell>
        <mxCell id="pwr_spec" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#D6B656;fontSize=11;verticalAlign=top;spacingTop=5;align=left;" value="&lt;b style=&quot;color:#5C3D00&quot;&gt;Electrical Detail&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.7;color:#2d2d2d&quot;&gt;Battery: 4S YUNFUHENG 50Q 21700 16.8V MAX, ~5000mAh&lt;br&gt;Charging: BQ24725, Max 100W, I2C Control&lt;br&gt;Protection: BQ40Z50, Overcharge / Over-discharge / Overcurrent / Short-circuit&lt;br&gt;Servos: TPS40305 DC-DC Buck 8.4V@20A MAX&lt;br&gt;LubanCat / YDLIDAR X2: TPS54821 DC-DC Buck 5V@6A MAX&lt;br&gt;STM32: RY8310 5V@1.2A MAX | ME6217 3.3V LDO@800mA MAX | RT9013 3.3V LDO@500mA MAX&lt;/div&gt;" vertex="1">
